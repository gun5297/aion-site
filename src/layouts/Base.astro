---
// Latin labels are shared; each page imports its own CJK faces (see src/pages).
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '../styles/global.css';
import { content, langs, type Lang } from '../i18n/content';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const site = Astro.site ?? new URL('https://example.com');
const absolute = (path: string) => new URL(withBase(path), site).href;
const canonical = absolute(t.path);
const ogLocale = lang === 'ja' ? 'ja_JP' : 'ko_KR';
// Share card (1200×630) rendered from the hero photo and copy. Japanese on every page by request;
// JPEG because chat apps like KakaoTalk skip WebP.
const ogImage = absolute('/og.jpg');
const ogImageAlt = `${content.ja.footer.name} — ${content.ja.hero.title.join('')}`;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => (
      <link rel="alternate" hreflang={content[l.lang].htmlLang} href={absolute(content[l.lang].path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute('/')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={t.footer.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
