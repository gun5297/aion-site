---
import { content, langs, type Lang } from '../i18n/content';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
---

<nav class:list={['lang', className]} aria-label={content[lang].langSwitch.label}>
  {langs.map((l) => (
    <a
      href={withBase(content[l.lang].path)}
      lang={content[l.lang].htmlLang}
      hreflang={content[l.lang].htmlLang}
      aria-current={l.lang === lang ? 'page' : undefined}
    >
      {l.label}
    </a>
  ))}
</nav>
